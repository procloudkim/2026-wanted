# Cloudflare Pages 정적 자산 헤더.
#
# 두 가지를 실측으로 배웠다.
#  1) 경로는 요청 경로와 맞아야 한다. "/index.html" 로 적으면 "/" 요청에는 적용되지 않는다.
#  2) 같은 패턴("/*")을 두 블록으로 나누면 뒤가 앞을 덮는다. 한 블록에 몰아 쓴다.
#
# 함수(/api/*)는 여기가 아니라 함수 스스로 헤더를 세운다(오리진 검사 포함).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; manifest-src 'self'
  ! Access-Control-Allow-Origin

/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# 파일명에 콘텐츠 해시가 없다. 긴 캐시를 걸면 배포해도 옛 코드가 계속 돈다(실측: 1시간).
# 조건부 요청으로 304 를 받는 편이, 심사 기간에 고친 것이 반영되지 않는 것보다 낫다.
/assets/*
  Cache-Control: no-cache
/og.png
  Cache-Control: public, max-age=3600

# 자산과 같은 이유로 no-cache 다. 파일명에 기준일도 해시도 없어서, max-age 를 걸면
# 자산을 새로 만든 뒤 앵커만 옛 파일이 남는 창이 생긴다. 실측: 새 필드(convert)가 없는
# 옛 앵커를 브라우저가 들고 있어 환산 카드가 "스냅샷을 읽지 못했다"로 내려갔다.
# 앵커와 코호트의 기준일이 갈리는 것보다 조건부 요청 두 번이 싸다.
/data/*
  Cache-Control: no-cache

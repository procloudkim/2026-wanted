# 환경변수 샘플 — 이 파일은 저장소에 올려도 되는 형식 문서다.
# 실제 값은 .env 에만 넣는다. .env 는 절대 커밋하지 않는다.
# git init 이후에는 .gitignore 에 ".env" 한 줄을 반드시 추가한다.
#
# 사용법
#   1) cp .env.sample .env
#   2) .env 의 빈 값에 실제 키를 붙여넣는다
#   3) 셸에서 불러오려면: set -a; . ./.env; set +a

# ── 공공데이터포털 (data.go.kr) ────────────────────────────────────────────
# 쓰는 곳: 국토교통부 아파트 전월세 실거래가 (데이터셋 15126474)
#          개발계정 자동승인, 개발 하루 10,000건, 응답 XML, 이용허락 제한 없음
# 발급: data.go.kr 로그인 → 데이터셋 15126474 → 활용신청(개발계정) → 마이페이지 인증키
# 주의: 포털은 Encoding 키와 Decoding 키를 둘 다 준다. 아래에는 **Decoding 키**를 넣고,
#       코드에서 URL 인코딩한다. Encoding 키를 그대로 쓰면 "+" 가 공백으로 바뀌어
#       SERVICE_KEY_IS_NOT_REGISTERED_ERROR 가 난다. 계정당 키 하나로 모든 API를 쓰고,
#       재발급하면 기존 키는 폐기된다.
DATA_GO_KR_SERVICE_KEY=

# ── 서울 열린데이터광장 (data.seoul.go.kr) ────────────────────────────────
# 쓰는 곳: 서울시 부동산 전월세가 정보 tbLnOpendataRentV (OA-21276)
#          호출당 1,000행, 매일 1회 갱신, 공공누리 1유형(출처표시, 상업 이용·변경 가능)
# 발급: 이미 보유 중. data.seoul.go.kr 마이페이지 → 인증키 관리에서 확인
# 주의: 엔드포인트가 HTTP 전용(:8088)이라 HTTPS 페이지에서 직접 호출하면 막힌다.
#       서버에서 호출한다.
SEOUL_OPEN_DATA_KEY=

# ── LLM (AI 단계) ─────────────────────────────────────────────────────────
# 쓰는 곳: 사용자가 받은 조건 문장을 계산 입력(JSON)으로 변환, 근거를 붙인 협상 문안 생성
#          판정은 코드가 하고 LLM은 판정하지 않는다
# 선택: OpenAI를 기본으로 쓴다(사용자 계정 보유). 교체는 호출부 한 곳만 고치면 된다.
OPENAI_API_KEY=
# 모델과 엔드포인트는 필요할 때만 채운다. 사내·프록시·Azure 경유면 BASE_URL을 지정한다.
OPENAI_MODEL=
OPENAI_BASE_URL=

# 대안 제공자. 지금은 쓰지 않으며 비워 둬도 된다.
ANTHROPIC_API_KEY=

# ── 선택 (지금 범위 밖) ───────────────────────────────────────────────────
# 카카오는 쓰지 않는다. 지도가 필요 없고, 카카오맵 REST 응답은 저장·캐시·LLM 전달이 금지다.
# 도로명주소·브이월드는 좌표를 쓰지 않아 불필요하다.
